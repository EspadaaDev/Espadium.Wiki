{
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog" }
      }
    ]
  },
  "Jwt": {
    "Issuer": "Espadium.Wiki",
    "Audience": "Espadium.Wiki",
    "Key": "CHANGE_ME_DEV_KEY_MIN_16_CHARS",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "S3": {
    "Endpoint": "http://localhost:9000",
    "Bucket": "wiki",
    "AccessKey": "dev",
    "SecretKey": "dev",
    "UseSsl": false
  },
  "Email": {
    "From": "no-reply@example.local",
    "SmtpHost": "localhost",
    "SmtpPort": 2525,
    "SmtpUser": "",
    "SmtpPassword": ""
  },
  "StorageLimits": {
    "MaxFileSizeMB": 50,
    "AllowedMimeTypes": [ "image/*", "application/pdf", "text/plain" ],
    "UsePresignedUrls": true,
    "MultipartUploadThresholdMB": 8
  },
  "ContentLimits": {
    "MaxPageLengthChars": 100000,
    "MaxTitleLength": 200,
    "MaxRevisionsPerPage": 50
  },
  "Security": {
    "PublicLinksEnabled": true,
    "DefaultPublicLinkTTLHours": 168,
    "RequireEmailVerification": false
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=wiki;Username=postgres;Password=postgres"
  },
  "Redis": {
    "Configuration": "localhost:6379"
  },
  "AllowedHosts": "*"
}
