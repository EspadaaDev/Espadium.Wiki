{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=wiki;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "Espadium.Wiki",
    "Audience": "Espadium.Wiki",
    "Key": "PLEASE_CHANGE_ME_dev_secret_key_min_32_chars",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "Redis": {
    "Configuration": "localhost:6379"
  },
  "S3": {
    "Endpoint": "http://localhost:9000",
    "Bucket": "wiki",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "UseSsl": false
  },
  "StorageLimits": {
    "MaxFileSizeMB": 50,
    "AllowedMimeTypes": [ "image/*", "application/pdf", "text/plain", "text/csv", "application/vnd.openxmlformats-officedocument.*" ],
    "UsePresignedUrls": true,
    "MultipartUploadThresholdMB": 8
  },
  "ContentLimits": {
    "MaxPageLengthChars": 100000,
    "MaxTitleLength": 200,
    "MaxRevisionsPerPage": 50
  },
  "Security": {
    "PublicLinksEnabled": true,
    "DefaultPublicLinkTTLHours": 168,
    "RequireEmailVerification": true
  },
  "Email": {
    "From": "no-reply@example.local",
    "SmtpHost": "localhost",
    "SmtpPort": 2525,
    "SmtpUser": "",
    "SmtpPassword": ""
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*"
}
